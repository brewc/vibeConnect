[Unit]
Description=VibeConnect SSH bastion
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=vibeconnectd
Group=vibeconnectd
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vibeconnectd /var/log/vibeconnectd
ExecStart=/usr/local/bin/vibeconnect-server start --config /etc/vibeconnectd/config.yaml
Restart=on-failure

[Install]
WantedBy=multi-user.target
